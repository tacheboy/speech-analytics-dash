{
  "id": "mid-bucket",
  "name": "Mid Bucket (DPD 31–90)",
  "icon": "handshake",
  "description": "Negotiation calls for 31–90 days past due. Goal: payment plan or partial payment, compliantly.",
  "sections": [
    {
      "id": "opening",
      "name": "Opening & Right-Party Verification",
      "criteria": [
        {
          "id": "op_greet_company",
          "question": "Did the agent greet the customer and identify themselves and Kaveri Finance?"
        },
        {
          "id": "op_rpc_verify",
          "question": "Did the agent verify they were speaking to the borrower before discussing the loan?",
          "context": "Asking for name confirmation, DOB or last 4 digits of the loan account counts."
        },
        {
          "id": "op_recording_disclosure",
          "question": "Did the agent inform the customer that the call is recorded?"
        }
      ]
    },
    {
      "id": "discovery",
      "name": "Discovery",
      "criteria": [
        {
          "id": "ds_reason_delay",
          "question": "Did the agent ask why the payments were missed?"
        },
        {
          "id": "ds_empathy",
          "question": "Did the agent acknowledge the customer’s situation with empathy?"
        },
        {
          "id": "ds_ability_to_pay",
          "question": "Did the agent assess what the customer can realistically pay now?"
        }
      ]
    },
    {
      "id": "negotiation",
      "name": "Negotiation",
      "criteria": [
        {
          "id": "ng_state_dues",
          "question": "Did the agent state the total overdue amount and number of missed EMIs?"
        },
        {
          "id": "ng_consequences",
          "question": "Did the agent explain the consequences of continued non-payment factually (credit bureau reporting, charges)?"
        },
        {
          "id": "ng_options",
          "question": "Did the agent offer at least one option (partial payment, revised date, restructuring request)?"
        }
      ]
    },
    {
      "id": "dispute_handling",
      "name": "Dispute Handling",
      "criteria": [
        {
          "id": "dp_log_ticket",
          "question": "Did the agent log the dispute and share a reference number?"
        },
        {
          "id": "dp_timeline",
          "question": "Did the agent share a resolution timeline?"
        },
        {
          "id": "dp_pause_collection",
          "question": "Did the agent confirm collection follow-ups pause while the dispute is reviewed?"
        }
      ]
    },
    {
      "id": "compliance",
      "name": "RBI Fair-Practice Compliance",
      "criteria": [
        {
          "id": "cp_no_threats",
          "question": "Did the agent avoid threats, intimidation or coercive language?",
          "context": "Threatening legal action, police, visiting the home/workplace, or shaming fails this."
        },
        {
          "id": "cp_respectful",
          "question": "Did the agent stay polite and avoid abusive or humiliating language?"
        },
        {
          "id": "cp_no_third_party",
          "question": "Did the agent avoid disclosing loan details to anyone other than the borrower?"
        }
      ]
    },
    {
      "id": "closure",
      "name": "Closure",
      "criteria": [
        {
          "id": "cl_ptp_secured",
          "question": "Did the agent secure a specific promise-to-pay amount and date?"
        },
        {
          "id": "cl_payment_mode",
          "question": "Did the agent confirm how the customer will pay (UPI, payment link, branch, auto-debit)?"
        },
        {
          "id": "cl_recap",
          "question": "Did the agent recap the commitment before ending the call?"
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "ptp",
      "label": "Promise to Pay",
      "description": "Customer committed to a specific amount and date for the overdue amount.",
      "isSuccess": true,
      "isNotApplicable": false
    },
    {
      "id": "partial",
      "label": "Partial Payment Agreed",
      "description": "Customer agreed to pay part of the overdue amount with a date.",
      "isSuccess": true,
      "isNotApplicable": false
    },
    {
      "id": "restructure",
      "label": "Restructure Request",
      "description": "Customer asked for EMI restructuring; request raised.",
      "isSuccess": false,
      "isNotApplicable": false
    },
    {
      "id": "dispute",
      "label": "Dispute Raised",
      "description": "Customer disputes the amount or charges.",
      "isSuccess": false,
      "isNotApplicable": false
    },
    {
      "id": "refused",
      "label": "Refused to Pay",
      "description": "Customer declined to commit to any payment.",
      "isSuccess": false,
      "isNotApplicable": false
    },
    {
      "id": "wrong_party",
      "label": "Wrong Party",
      "description": "Borrower not reached; someone else answered or wrong number.",
      "isSuccess": false,
      "isNotApplicable": true
    }
  ],
  "extractionFields": [
    {
      "fieldName": "delay_reason",
      "displayName": "Delay Reason",
      "fieldType": "enum",
      "description": "Primary reason the customer gives for missing the payment.",
      "required": true,
      "enumOptions": [
        {
          "value": "job_loss"
        },
        {
          "value": "medical"
        },
        {
          "value": "business_slowdown"
        },
        {
          "value": "salary_delay"
        },
        {
          "value": "forgot"
        },
        {
          "value": "dispute"
        },
        {
          "value": "other",
          "hint": "Use only when no listed reason fits"
        }
      ]
    },
    {
      "fieldName": "ptp_amount",
      "displayName": "PTP Amount (₹)",
      "fieldType": "number",
      "description": "Amount the customer promised to pay, in rupees. Null if no promise.",
      "required": false
    },
    {
      "fieldName": "ptp_date",
      "displayName": "PTP Date",
      "fieldType": "text",
      "description": "Date the customer promised to pay, as said on the call.",
      "required": false
    },
    {
      "fieldName": "payment_mode",
      "displayName": "Payment Mode",
      "fieldType": "enum",
      "description": "How the customer said they will pay.",
      "required": false,
      "enumOptions": [
        {
          "value": "upi"
        },
        {
          "value": "payment_link"
        },
        {
          "value": "branch"
        },
        {
          "value": "auto_debit"
        },
        {
          "value": "none"
        }
      ]
    },
    {
      "fieldName": "hardship",
      "displayName": "Financial Hardship",
      "fieldType": "boolean",
      "description": "True if the customer describes genuine financial hardship (job loss, medical emergency).",
      "required": false
    }
  ],
  "targetingRules": [
    {
      "targetType": "section",
      "targetId": "dispute_handling",
      "description": "Only when the customer raises a dispute",
      "expression": {
        "or": [
          {
            "==": [
              {
                "var": "outcome.id"
              },
              "dispute"
            ]
          },
          {
            "==": [
              {
                "var": "extractions.delay_reason"
              },
              "dispute"
            ]
          }
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "compliance/threats",
      "description": "Threat criterion answered No",
      "expression": {
        "==": [
          {
            "var": "criteria.cp_no_threats"
          },
          "fail"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "compliance/abusive",
      "description": "Respect criterion answered No",
      "expression": {
        "==": [
          {
            "var": "criteria.cp_respectful"
          },
          "fail"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "compliance/third-party",
      "description": "Third-party criterion answered No",
      "expression": {
        "==": [
          {
            "var": "criteria.cp_no_third_party"
          },
          "fail"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "compliance/no-recording-disclosure",
      "description": "Recording disclosure answered No",
      "expression": {
        "==": [
          {
            "var": "criteria.op_recording_disclosure"
          },
          "fail"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "objection/financial/job-loss",
      "description": "Delay reason is job loss",
      "expression": {
        "==": [
          {
            "var": "extractions.delay_reason"
          },
          "job_loss"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "objection/financial/medical",
      "description": "Delay reason is medical",
      "expression": {
        "==": [
          {
            "var": "extractions.delay_reason"
          },
          "medical"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "objection/financial/business-slowdown",
      "description": "Delay reason is business slowdown",
      "expression": {
        "==": [
          {
            "var": "extractions.delay_reason"
          },
          "business_slowdown"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "objection/financial/salary-delay",
      "description": "Delay reason is salary delay",
      "expression": {
        "==": [
          {
            "var": "extractions.delay_reason"
          },
          "salary_delay"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "follow-up/callback",
      "description": "Outcome is Callback Requested",
      "expression": {
        "==": [
          {
            "var": "outcome.id"
          },
          "callback"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "follow-up/ptp-due",
      "description": "A PTP date was captured",
      "expression": {
        "!!": [
          {
            "var": "extractions.ptp_date"
          }
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "follow-up/payment-link",
      "description": "Customer will pay via payment link",
      "expression": {
        "==": [
          {
            "var": "extractions.payment_mode"
          },
          "payment_link"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "objection/unwilling/refused",
      "description": "Outcome is Refused to Pay",
      "expression": {
        "==": [
          {
            "var": "outcome.id"
          },
          "refused"
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "objection/dispute",
      "description": "Customer raised a dispute",
      "expression": {
        "or": [
          {
            "==": [
              {
                "var": "outcome.id"
              },
              "dispute"
            ]
          },
          {
            "==": [
              {
                "var": "extractions.delay_reason"
              },
              "dispute"
            ]
          }
        ]
      }
    },
    {
      "targetType": "tag",
      "targetId": "value/high",
      "description": "PTP of ₹10,000 or more",
      "expression": {
        ">=": [
          {
            "var": "extractions.ptp_amount"
          },
          10000
        ]
      }
    }
  ],
  "intendedPurpose": "Negotiation calls for 31–90 days past due. Goal: payment plan or partial payment, compliantly.",
  "additionalLLMContext": "Calls are code-mixed (Tamil/Kannada/Hindi with English). Judge intent, not exact wording. RBI Fair Practices Code applies: calls only 08:00–19:00, no threats, no disclosure to third parties.",
  "tagTargets": [
    "compliance/threats",
    "compliance/abusive",
    "compliance/third-party",
    "compliance/no-recording-disclosure",
    "objection/financial/job-loss",
    "objection/financial/medical",
    "objection/financial/business-slowdown",
    "objection/financial/salary-delay",
    "follow-up/callback",
    "follow-up/ptp-due",
    "follow-up/payment-link",
    "objection/unwilling/refused",
    "objection/dispute",
    "value/high"
  ]
}
